<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>DefaultBackground</include>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<!-- Right panel: per-entry widgets -->
			<control type="group" id="2000">
				<left>462</left>
				<include>OpenClose_Right</include>

				<control type="group" id="5000">
					<visible>String.IsEqual(Container(9000).ListItem.Property(id),library)</visible>
					<include content="Visible_Right_Delayed">
						<param name="id" value="library"/>
					</include>
					<include content="ImageWidget" condition="System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31701]" />
						<param name="button_label" value="$LOCALIZE[31702]" />
						<param name="button_onclick" value="ActivateWindow(Videos,plugin://plugin.video.fntvbox/,return)"/>
						<param name="button_id" value="5500"/>
						<param name="button2_label" value="$LOCALIZE[31706]" />
						<param name="button2_onclick" value="ActivateWindow(settings)"/>
						<param name="visible_2" value="true"/>
					</include>
					<include content="ImageWidget" condition="!System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31705]" />
						<param name="button_label" value="$LOCALIZE[31706]" />
						<param name="button_onclick" value="ActivateWindow(settings)"/>
						<param name="button_id" value="5501"/>
						<param name="visible_2" value="false"/>
					</include>
				</control>

				<control type="group" id="6000">
					<visible>String.IsEqual(Container(9000).ListItem.Property(id),live)</visible>
					<include content="Visible_Right_Delayed">
						<param name="id" value="live"/>
					</include>
					<include content="ImageWidget" condition="System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31703]" />
						<param name="button_label" value="$LOCALIZE[31703]" />
						<param name="button_onclick" value="ActivateWindow(Videos,plugin://plugin.video.fntvbox/?action=live_groups,return)"/>
						<param name="button_id" value="6500"/>
						<param name="visible_2" value="false"/>
					</include>
					<include content="ImageWidget" condition="!System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31705]" />
						<param name="button_label" value="$LOCALIZE[31706]" />
						<param name="button_onclick" value="ActivateWindow(settings)"/>
						<param name="button_id" value="6501"/>
						<param name="visible_2" value="false"/>
					</include>
				</control>

				<control type="group" id="7000">
					<visible>String.IsEqual(Container(9000).ListItem.Property(id),search)</visible>
					<include content="Visible_Right_Delayed">
						<param name="id" value="search"/>
					</include>
					<include content="ImageWidget" condition="System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31704]" />
						<param name="button_label" value="$LOCALIZE[31704]" />
						<param name="button_onclick" value="ActivateWindow(Videos,plugin://plugin.video.fntvbox/?action=search,return)"/>
						<param name="button_id" value="7500"/>
						<param name="visible_2" value="false"/>
					</include>
					<include content="ImageWidget" condition="!System.HasAddon(plugin.video.fntvbox)">
						<param name="text_label" value="$LOCALIZE[31705]" />
						<param name="button_label" value="$LOCALIZE[31706]" />
						<param name="button_onclick" value="ActivateWindow(settings)"/>
						<param name="button_id" value="7501"/>
						<param name="visible_2" value="false"/>
					</include>
				</control>

				<control type="group" id="8000">
					<visible>String.IsEqual(Container(9000).ListItem.Property(id),settings)</visible>
					<include content="Visible_Right_Delayed">
						<param name="id" value="settings"/>
					</include>
					<include content="ImageWidget">
						<param name="text_label" value="$LOCALIZE[31707]" />
						<param name="button_label" value="$LOCALIZE[31706]" />
						<param name="button_onclick" value="ActivateWindow(settings)"/>
						<param name="button_id" value="8500"/>
						<param name="button2_label" value="$LOCALIZE[33060]" />
						<param name="button2_onclick" value="ActivateWindow(shutdownmenu)"/>
						<param name="visible_2" value="true"/>
					</include>
				</control>
			</control>

			<!-- Left menu -->
			<control type="group">
				<depth>DepthContentPanel</depth>
				<include>OpenClose_Left</include>
				<include content="ContentPanel">
					<param name="width" value="522" />
				</include>
				<control type="label">
					<left>30</left>
					<top>110</top>
					<width>420</width>
					<height>90</height>
					<font>font45_title</font>
					<label>$LOCALIZE[31700]</label>
					<textcolor>button_focus</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<align>left</align>
					<aligny>center</aligny>
				</control>
				<control type="label">
					<left>30</left>
					<top>185</top>
					<width>420</width>
					<height>40</height>
					<font>font13</font>
					<label>$LOCALIZE[31708]</label>
					<textcolor>grey</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
				<control type="fixedlist" id="9000">
					<left>0</left>
					<top>240</top>
					<width>462</width>
					<bottom>-10</bottom>
					<movement>4</movement>
					<focusposition>0</focusposition>
					<onfocus>ClearProperty(listposition,home)</onfocus>
					<onright>SetFocus($INFO[Container(9000).ListItem.Property(menu_id)])</onright>
					<onup>700</onup>
					<ondown>700</ondown>
					<scrolltime tween="cubic" easing="out">500</scrolltime>
					<focusedlayout height="95">
						<control type="group">
							<animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
							<control type="image">
								<left>0</left>
								<top>0</top>
								<width>462</width>
								<height>95</height>
								<texture colordiffuse="button_focus">lists/focus.png</texture>
								<animation effect="fade" start="100" end="0" time="0" condition="[!Control.HasFocus(9000) + !ControlGroup(700).HasFocus] | System.HasActiveModalDialog">Conditional</animation>
							</control>
							<control type="image">
								<left>-3</left>
								<top>1</top>
								<width>95</width>
								<height>95</height>
								<texture colordiffuse="button_focus">$INFO[ListItem.Art(thumb)]</texture>
							</control>
						</control>
						<control type="image">
							<left>-3</left>
							<top>1</top>
							<width>95</width>
							<height>95</height>
							<texture>$INFO[ListItem.Art(thumb)]</texture>
						</control>
						<control type="label">
							<left>104</left>
							<top>0</top>
							<height>95</height>
							<width>340</width>
							<aligny>center</aligny>
							<font>font37</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
					</focusedlayout>
					<itemlayout height="95">
						<control type="image">
							<left>-3</left>
							<top>1</top>
							<width>95</width>
							<height>95</height>
							<texture colordiffuse="44FFFFFF">$INFO[ListItem.Art(thumb)]</texture>
						</control>
						<control type="label">
							<left>104</left>
							<top>0</top>
							<height>95</height>
							<width>340</width>
							<aligny>center</aligny>
							<font>font37</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
					</itemlayout>
					<content>
						<item>
							<label>$LOCALIZE[31702]</label>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.fntvbox/,return)</onclick>
							<property name="menu_id">$NUMBER[5000]</property>
							<thumb>icons/sidemenu/videos.png</thumb>
							<property name="id">library</property>
						</item>
						<item>
							<label>$LOCALIZE[31703]</label>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.fntvbox/?action=live_groups,return)</onclick>
							<property name="menu_id">$NUMBER[6000]</property>
							<thumb>icons/sidemenu/livetv.png</thumb>
							<property name="id">live</property>
						</item>
						<item>
							<label>$LOCALIZE[31704]</label>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.fntvbox/?action=search,return)</onclick>
							<property name="menu_id">$NUMBER[7000]</property>
							<thumb>icons/sidemenu/addons.png</thumb>
							<property name="id">search</property>
						</item>
						<item>
							<label>$LOCALIZE[31706]</label>
							<onclick>ActivateWindow(settings)</onclick>
							<property name="menu_id">$NUMBER[8000]</property>
							<thumb>icons/settings.png</thumb>
							<property name="id">settings</property>
						</item>
					</content>
				</control>
				<control type="grouplist" id="700">
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<left>-8</left>
					<width>480</width>
					<height>110</height>
					<top>100</top>
					<onup>SetFocus(9000,99,absolute)</onup>
					<ondown>SetFocus(9000,0,absolute)</ondown>
					<onright>2000</onright>
					<align>justify</align>
					<include content="IconButton">
						<param name="control_id" value="804" />
						<param name="onclick" value="ActivateWindow(shutdownmenu)" />
						<param name="icon" value="icons/power.png" />
						<param name="label" value="$LOCALIZE[33060]" />
					</include>
					<include content="IconButton">
						<param name="control_id" value="802" />
						<param name="onclick" value="ActivateWindow(settings)" />
						<param name="icon" value="icons/settings.png" />
						<param name="label" value="$LOCALIZE[21417]" />
					</include>
				</control>
			</control>
			<include>BottomBar</include>
			<include content="TopBar">
				<param name="breadcrumbs_label" value="$LOCALIZE[31700]" />
			</include>
		</control>
	</controls>
</window>
